# All optional — the app runs on the committed seed dataset without any of these.

# Supabase (production data store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token required by POST /api/ingest when set
INGEST_SECRET=

# Scheduled ingestion (/api/cron/ingest, daily via vercel.json)
# CRON_SECRET: set in Vercel; injected automatically into cron invocations
CRON_SECRET=
# HTTPS endpoint returning a PatchDataset JSON (community data-dump export)
DATASET_URL=
